# Environment Configuration — Backend

# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=finance_user
DATABASE_PASSWORD=finance_password_dev
DATABASE_NAME=finance_os_db

# JWT
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Redis (future)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (future)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3001

# Card encryption key (AES-256) — obrigatória, mín. 32 caracteres; o backend não sobe
# sem ela nem com este valor de exemplo. Gerar com: openssl rand -hex 32
# Trocar a chave torna ilegíveis os cartões já salvos: guarde uma cópia.
CARD_ENCRYPTION_KEY=change_this_to_a_long_random_string_in_production

# Logging
LOG_LEVEL=debug

# Cotações da brapi.dev (opcional). Sem token, só ativos de teste (PETR4, VALE3...).
# BRAPI_TOKEN=
